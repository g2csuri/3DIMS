      async loadRoomLibrary() {
          try {
                  const response = await fetch('/api/room_library');
                  const rooms = await response.json();

                  const dropdown = document.getElementById('room-library-dropdown');
                  const button = document.getElementById('room-library-btn');
                  dropdown.innerHTML = '';

                  rooms.forEach(room => {
                      const option = document.createElement('div');
                      option.className = 'dropdown-option';
                      option.dataset.filename = room.filename;
                      option.textContent = room.display;
                      option.onclick = () => this.selectLibraryRoom(room);
                      dropdown.appendChild(option);
                  });

                  button.onclick = () => {
                      const isOpen = dropdown.classList.contains('show');
                      document.querySelectorAll('.select-dropdown').forEach(d => d.classList.remove('show'));
                      if (!isOpen) dropdown.classList.add('show');
                  };
              }
              catch (error) {
                  //console.error('Failed to load room library:', error);
              }
      }

      // NEW: Handle room selection
      selectLibraryRoom(room) {
          const button = document.getElementById('room-library-btn');
          const dropdown = document.getElementById('room-library-dropdown');
          button.querySelector('.selected-text').textContent = room.display;
          dropdown.classList.remove('show');
          this.selectedRoom = room.filename;
          //console.log(`Selected room: ${room.filename}`);
      }



    // FIXED 10.1c: Fixed handleAdd method (add this)
    async handleAdd() {
        //console.log('Add clicked:', {room: this.selectedRoom, device: this.selectedDeviceFile});

        if (!this.selectedRoom || !this.selectedDeviceFile) {
            alert('Select Room AND Device first');
            return;
        }

        try {
            const response = await fetch('/api/add_device', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({
                    room: this.selectedRoom,
                    device: this.selectedDeviceFile
                })
            });

            const result = await response.json();
            if (result.success) {
                //console.log('✅ Added:', result.device_name, 'to', result.room_file);

                // Reload tree (left pane updates)
                await this.loadTree();
                await this.updatePreview();

                // Reset selectors
                this.selectedRoom = null;
                this.selectedDeviceFile = null;
                document.querySelector('#room-library-btn .selected-text').textContent = 'Select Room...';
                document.querySelector('#device-library-btn .selected-text').textContent = 'Select Device...';

                //alert(`✅ Added ${result.device_name} to ${result.room_file}`);
            } else {
                alert('❌ Add failed: ' + (result.error || 'Unknown error'));
            }
        } catch (error) {
            console.error('Add error:', error);
            alert('❌ Network error - check console');
        }
    }


async handleRemove() {
    console.log('Remove clicked, device:', this.selectedDevice, 'file:', this.selectedFile);

    if (!this.selectedDevice || !this.selectedFile) {
        //alert('Select a device from the left tree first!');
        return;
    }

    // Highlight device in 3D (optional)
    this.highlightDevice(this.selectedDevice);

    const roomFile = this.selectedFile.endsWith('.js')
        ? this.selectedFile
        : this.selectedFile + '.js';

    if (!confirm(`Delete "${this.selectedDevice}" from "${roomFile}"?\n\nThis removes the whole device block.`)) {
        return; // Cancel
    }

    try {
        const response = await fetch('/api/remove_device', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                room: roomFile,
                device_name: this.selectedDevice
            })
        });

        const result = await response.json();

        if (result.success) {
            //console.log('✅ Removed', result.device, 'from', result.room);
            await this.loadTree();
            await this.updatePreview();

            this.selectedDevice = null;
            document.querySelectorAll('.tree-item').forEach(el => el.classList.remove('selected'));
            //alert(`Removed ${result.device} from ${result.room}`);
        } else {
            alert('Remove failed: ' + result.error);
        }
    } catch (err) {
        //console.error('Remove error:', err);
        alert('Network error - check console');
    }
}

// Simple highlight (add to existing class)
highlightDevice(deviceName) {
    // Pulse all objects with matching name
    if (window.editorScene) {
        window.editorScene.traverse((obj) => {
            if (obj.name === deviceName || obj.userData.deviceName === deviceName) {
                // Simple scale pulse
                const originalScale = obj.scale.clone();
                const pulse = () => {
                    obj.scale.lerp(new THREE.Vector3(1.2, 1.2, 1.2), 0.1);
                    if (obj.scale.x > 1.15) {
                        obj.scale.copy(originalScale);
                    } else {
                        requestAnimationFrame(pulse);
                    }
                };
                pulse();
            }
        });
    }
}

async loadDeviceProperties(filename, deviceName) {
    try {
        // Auto .js extension is already handled in backend, but you can normalize if you like
        const roomFile = filename.endsWith('.js') ? filename : `${filename}.js`;

        const response = await fetch(
            `/api/deviceprops?room=${encodeURIComponent(roomFile)}&device=${encodeURIComponent(deviceName)}`
        );

        if (!response.ok) {
            throw new Error(`HTTP ${response.status}: ${response.statusText}`);
        }

        const data = await response.json();
        if (data.success) {
            //console.log('Loaded props', Object.keys(data.vars)); // debug
            this.deviceVars = data.vars;
            this.renderProperties(filename, deviceName);
        } else {
            //console.error('Backend error', data.error);
            this.propertiesEditor.innerHTML =
                `<div style="padding:20px;color:#666;">Failed: ${data.error}</div>`;
        }
    } catch (error) {
        //console.error('Load props error:', error);
        this.propertiesEditor.innerHTML =
            '<div style="padding:20px;color:#666;">Network/Parse error - check console</div>';
    }
}

