renderProperties(filename, deviceName) {
    const groups = {
        'Basic': ['category', 'roomType', 'deviceColor', 'deviceWidth', 'deviceHeight', 'deviceDepth', 'orientation', 'standHeight', 'knobHeight', 'gaugeThickness', 'unitCount', 'pipeOrientation', 'ductOrientation', 'deviceOrientation'],
        'Radius': ['deviceRadius', 'domeRadius', 'standRadius', 'knobRadius', 'gaugeRadius', 'pipeRadius'],
        'Position': ['devicePosition', 'camPosition','knobPosition', 'gaugePosition'],
        'Text Label': ['text', 'labelOrientation', 'textPosition', 'textSize', 'textColor', 'textFont', 'textCanvasBgColor', 'textbgSize'],
        'Screen': ['screenEnabled','screenPosition', 'screenSize', 'screenColor'],
        'Textures': ['faceTextures','plugInBoxTextures', 'endFeedTextures'],
        'LED': ['ledEnabled', 'ledRadius', 'ledOffset', 'ledBlinkPeriod'],
        'Live Data': ['deviceId', 'urlLink','zbxSrvIP', 'zbxAPI', 'zbxHost','NBSrvIP', 'NBAPI', 'NBRackID'], //'NBFront', 'NBRear'],
        // SPECIAL VARIABLES
        'Tiles': ['tileSize'],
        'Airflow': ['airflowPercentage'],
        'Door':['doorWidth', 'doorHeight', 'doorOffset', 'numberOfDoors', 'doorType', 'glassWidth', 'glassHeight', 'glassPosition'],
        'TileSize':['floorTileSize', 'ceilingTileSize'],
        'Animation':['fanEnabled', 'fanSpeed', 'fanSize', 'fanPosition', 'fanColor', 'zbxKey', 'fanOnValue'],
        'ClockConfig':['clockType','LEDactiveColor', 'LEDdimColor', 'LEDscreenColor'],
        'TrayTurn':['Front_Side_Opening', 'Rear_Side_Opening'],

        'PipeFrontEnd':['F_B1_Sts','F_B1_H','F_B1_V', 'F_B1_L', 'F_B2_Sts', 'F_B2_H', 'F_B2_V', 'F_B2_L', 'F_B3_Sts', 'F_B3_H', 'F_B3_V', 'F_B3_L'],
        'PipeRearEnd':['R_B1_Sts','R_B1_H','R_B1_V', 'R_B1_L', 'R_B2_Sts', 'R_B2_H', 'R_B2_V', 'R_B2_L', 'R_B3_Sts', 'R_B3_H', 'R_B3_V', 'R_B3_L'],
        'DuctFrontEnd':['F_D1_Sts','F_D1_H','F_D1_V', 'F_D1_L', 'F_D2_Sts', 'F_D2_H', 'F_D2_V', 'F_D2_L', 'F_D3_Sts', 'F_D3_H', 'F_D3_V', 'F_D3_L'],
        'DuctRearEnd':['R_D1_Sts','R_D1_H','R_D1_V', 'R_D1_L', 'R_D2_Sts', 'R_D2_H', 'R_D2_V', 'R_D2_L', 'R_D3_Sts', 'R_D3_H', 'R_D3_V', 'R_D3_L'],

        //EDuct related
        'PlugInBox':['numPlugInBoxes', 'plugInBoxInterval', 'plugInBoxPositions', 'plugInBoxWidth', 'plugInBoxHeight', 'plugInBoxDepth','plugInBoxPosition'],
        'EndFeedUnit':['enableEndFeedRight', 'enableEndFeedLeft', 'endFeedWidth', 'endFeedHeight', 'endFeedDepth'],
        'Rods':['enableHangingScrews', 'numHangingScrews', 'screwLength'],
        'EDuctAnimation':['flowAnimation','arrowFlowDirection', 'flowSpeed', 'flowColor', 'arrowIntensity', 'flowOnValue', 'zbxKey']

    };

    let html = `
        <div class="device-header-title" style="
            font-size: 16px;
            font-weight: bold;
            color: #2c3e50;
            padding-bottom: 10px;
            margin-bottom: 15px;
            border-bottom: 2px solid #3498db;
            text-transform: none;">
            📦 ${filename.replace('.js', '')} : ${deviceName.replace('.js', '')}
        </div>
    `;

    Object.entries(groups).forEach(([groupName, keys]) => {
        // ✅ HIDE EMPTY GROUPS
        const groupVars = keys.filter(key => this.deviceVars[key] !== undefined);
        if (groupVars.length === 0) return;

        html += `
            <div class="properties-group">
                <div class="group-header" data-group="${groupName}">
                    <span>${groupName} (${groupVars.length})</span>
                    <span style="font-size:12px">▼</span>
                </div>
                <div class="group-content">
        `;

        groupVars.forEach(key => {
            // SPECIAL CASE: Custom array input handling for plugInBoxPositions
            if (key === 'plugInBoxPositions') {
                const positions = Array.isArray(this.deviceVars[key]) ? this.deviceVars[key] : [];
                const boxCount = parseInt(this.deviceVars['numPlugInBoxes']) || positions.length || 0;

                html += `
                    <div class="prop-row" style="display:flex; flex-direction:column; margin-bottom:8px;">
                        <label style="font-size:13px; margin-bottom:4px;">plugInBoxPositions:</label>
                        <div class="vector-inputs" style="display:flex; gap:4px; align-items:center; flex-wrap:wrap; padding-left:15px;">
                `;

                if (boxCount === 0) {
                    html += `<span style="font-size:11px; color:#888;">No boxes enabled</span>`;
                } else {
                    for (let idx = 0; idx < boxCount; idx++) {
                        const posVal = (positions[idx] !== undefined && positions[idx] !== null) ? positions[idx] : '';
                        html += `
                            <div style="display:flex; align-items:center; gap:2px;">
                                <span style="font-size:11px; color:#666;">#${idx + 1}:</span>
                                <input class="prop-input" data-key="plugInBoxPositions.${idx}" type="number" step="0.01"
                                       value="${posVal !== '' ? parseFloat(posVal).toFixed(2) : ''}" 
                                       placeholder="Auto" style="width:55px; padding:2px;">
                            </div>
                        `;
                    }
                }

                html += `
                        </div>
                    </div>
                `;
            } else {
                html += this.renderProp(key, this.deviceVars[key]);
            }
        });

        html += '</div></div>';
    });

    html += '<button class="apply-btn" onclick="editor.applyChanges()">Apply Changes</button></div>';
    this.propertiesEditor.innerHTML = html;

    // Toggle wiring
    this.propertiesEditor.querySelectorAll('.group-header').forEach(header => {
        header.onclick = () => {
            const content = header.nextElementSibling;
            content.classList.toggle('show');
            header.lastElementChild.textContent = content.classList.contains('show') ? '▲' : '▼';
        };
    });
}



renderProp(key, value) {
    // 1. DECIMAL FIELDS
    const decimalKeys = [
        'deviceWidth', 'deviceHeight', 'deviceDepth', 'standHeight',
        'textSize', 'ledRadius', 'ledHeight', 'ledBlinkPeriod',
        'highTextSize', 'highLineWidth', 'highDotRadius'
    ];
    const isDecimal = decimalKeys.includes(key);

    // 2. POSITION/VECTOR FIELDS (Ensuring x, y, z are always present)
    const isVector = key.toLowerCase().includes('position') || key.toLowerCase().includes('size') || key === 'ledOffset';

    let inputHtml = '';

    // SPECIAL CASE: faceTextures
    if (key === 'faceTextures') {
        const tex = value || {};
        const sides = ['front', 'back', 'left', 'right', 'top', 'bottom'];
        let html = `<div class="texture-group"><div class="texture-header">faceTextures</div>`;
        sides.forEach(side => {
            const currentPath = tex[side] || 'none';
            html += `
                <div class="texture-row" style="padding-left:15px; display:flex; justify-content:space-between; align-items:center;">
                    <span>${side.charAt(0).toUpperCase() + side.slice(1)}:</span>
                    <button type="button" class="file-btn" onclick="window.editorInstance.pickTexture('${side}')">Pick File</button>
                </div>
                <div class="texture-path-text" data-side="${side}" style="padding-left:15px; margin-bottom:10px;">${currentPath}</div>`;
        });
        html += `</div>`;
        return html;
    }
    // SPECIAL CASE: plugInBoxTextures
    if (key === 'plugInBoxTextures') {
        const tex = value || {};
        const sides = ['pfront', 'pback'];
        let html = `<div class="texture-group"><div class="texture-header">plugInBoxTextures</div>`;
        sides.forEach(side => {
            const currentPath = tex[side] || 'none';
            html += `
                <div class="texture-row" style="padding-left:15px; display:flex; justify-content:space-between; align-items:center;">
                    <span>${side.charAt(0).toUpperCase() + side.slice(1)}:</span>
                    <button type="button" class="file-btn" onclick="window.editorInstance.pickTexture('${side}')">Pick File</button>
                </div>
                <div class="texture-path-text" data-side="${side}" style="padding-left:15px; margin-bottom:10px;">${currentPath}</div>`;
        });
        html += `</div>`;
        return html;
    }
    if (key === 'endFeedTextures') {
        const tex = value || {};
        const sides = ['efront', 'eback'];
        let html = `<div class="texture-group"><div class="texture-header">endFeedTextures</div>`;
        sides.forEach(side => {
            const currentPath = tex[side] || 'none';
            html += `
                <div class="texture-row" style="padding-left:15px; display:flex; justify-content:space-between; align-items:center;">
                    <span>${side.charAt(0).toUpperCase() + side.slice(1)}:</span>
                    <button type="button" class="file-btn" onclick="window.editorInstance.pickTexture('${side}')">Pick File</button>
                </div>
                <div class="texture-path-text" data-side="${side}" style="padding-left:15px; margin-bottom:10px;">${currentPath}</div>`;
        });
        html += `</div>`;
        return html;
    }

    // CASE: Orientation dropdown
    if (key === 'roomType') {
        const options = ['room', 'container'];
        inputHtml += `<select class="prop-input" data-key="${key}">`;
        options.forEach(opt => {
            inputHtml += `<option value="${opt}" ${value === opt ? 'selected' : ''}>${opt}</option>`;
        });
        inputHtml += '</select>';
    }
    else if (key === 'category') {
        const options = ['power', 'cooling', 'electrical', 'networking','IT','safety', 'fire'];
        inputHtml += `<select class="prop-input" data-key="${key}">`;
        options.forEach(opt => {
            inputHtml += `<option value="${opt}" ${value === opt ? 'selected' : ''}>${opt}</option>`;
        });
        inputHtml += '</select>';
    }
    else if (key === 'orientation') {
        const options = ['Front', 'Back', 'Left', 'Right', 'Top', 'Bottom'];
        inputHtml += `<select class="prop-input" data-key="${key}">`;
        options.forEach(opt => {
            inputHtml += `<option value="${opt}" ${value === opt ? 'selected' : ''}>${opt}</option>`;
        });
        inputHtml += '</select>';
    }
    else if (key === 'pipeOrientation') {
        const options = ['Horizontal_FrontBack', 'Horizontal_LeftRight', 'Vertical'];
        inputHtml += `<select class="prop-input" data-key="${key}">`;
        options.forEach(opt => {
            inputHtml += `<option value="${opt}" ${value === opt ? 'selected' : ''}>${opt}</option>`;
        });
        inputHtml += '</select>';
    }
    else if (key === 'labelOrientation') {
        const options = ['Front', 'Back', 'Left', 'Right'];
        inputHtml += `<select class="prop-input" data-key="${key}">`;
        options.forEach(opt => {
            inputHtml += `<option value="${opt}" ${value === opt ? 'selected' : ''}>${opt}</option>`;
        });
        inputHtml += '</select>';
    }
    else if (key === 'deviceOrientation') {
        const options = ['Front', 'Back', 'Left', 'Right', 'Top', 'Bottom'];
        inputHtml += `<select class="prop-input" data-key="${key}">`;
        options.forEach(opt => {
            inputHtml += `<option value="${opt}" ${value === opt ? 'selected' : ''}>${opt}</option>`;
        });
        inputHtml += '</select>';
    }
    else if (key === 'ductOrientation') {
        const options = ['Horizontal_FrontBack', 'Horizontal_LeftRight', 'Vertical'];
        inputHtml += `<select class="prop-input" data-key="${key}">`;
        options.forEach(opt => {
            inputHtml += `<option value="${opt}" ${value === opt ? 'selected' : ''}>${opt}</option>`;
        });
        inputHtml += '</select>';
    }
    else if (key === 'clockType') {
        const options = ['LED', 'LCD'];
        inputHtml += `<select class="prop-input" data-key="${key}">`;
        options.forEach(opt => {
            inputHtml += `<option value="${opt}" ${value === opt ? 'selected' : ''}>${opt}</option>`;
        });
        inputHtml += '</select>';
    }
    else if (key === 'plugInBoxPosition') {
        const options = ['Front', 'Back', 'Below', 'Above'];
        inputHtml += `<select class="prop-input" data-key="${key}">`;
        options.forEach(opt => {
            inputHtml += `<option value="${opt}" ${value === opt ? 'selected' : ''}>${opt}</option>`;
        });
        inputHtml += '</select>';
    }


/*
    else if (key === 'Front_Side_Opening') {
        const options = ['Close', 'Left', 'Right', 'Straight'];
        inputHtml += `<select class="prop-input" data-key="${key}">`;
        options.forEach(opt => {
            inputHtml += `<option value="${opt}" ${value === opt ? 'selected' : ''}>${opt}</option>`;
        });
        inputHtml += '</select>';
    }
    else if (key === 'Rear_Side_Opening') {
        const options = ['Close', 'Left', 'Right', 'Straight'];
        inputHtml += `<select class="prop-input" data-key="${key}">`;
        options.forEach(opt => {
            inputHtml += `<option value="${opt}" ${value === opt ? 'selected' : ''}>${opt}</option>`;
        });
        inputHtml += '</select>';
    }
*/
    // ['front_PipeBendStatus','rear_PipeBendStatus','front_ExtendedPipeBendStatus','rear_ExtendedPipeBendStatus']
    else if (key === 'F_B1_Sts' || key === 'F_B2_Sts' || key === 'F_B3_Sts' ||
             key === 'R_B1_Sts' || key === 'R_B2_Sts' || key === 'R_B3_Sts') {
        const options = [
            'Close', 
            'Enable', 
        ];
        inputHtml += `<select class="prop-input" data-key="${key}">`;
        options.forEach(opt => {
            const isSelected = String(value).trim().toUpperCase() === opt.toUpperCase();
            inputHtml += `<option value="${opt}" ${isSelected ? 'selected' : ''}>${opt}</option>`;
        });
        inputHtml += '</select>';
    }
    else if (key === 'F_D1_Sts' || key === 'F_D2_Sts' || key === 'F_D3_Sts' ||
             key === 'R_D1_Sts' || key === 'R_D2_Sts' || key === 'R_D3_Sts') {
        const options = [
            'Close', 
            'Enable', 
        ];
        inputHtml += `<select class="prop-input" data-key="${key}">`;
        options.forEach(opt => {
            const isSelected = String(value).trim().toUpperCase() === opt.toUpperCase();
            inputHtml += `<option value="${opt}" ${isSelected ? 'selected' : ''}>${opt}</option>`;
        });
        inputHtml += '</select>';
    }


/*
    else if (key === 'Front_PipeBend' || key === 'Rear_PipeBend' || key === 'front_ExtendedPipeBend' || key === 'rear_ExtendedPipeBend') {
        const options = [
            'Close', 
            'Left', 
            'Right', 
            'Straight', 
            'Left & Right', 
            'Left & Straight', 
            'Right & Straight', 
            'Left & Right & Straight', 
            'Up', 
            'Down', 
            'Up & Down', 
            'Up & Down & Left', 
            'Up & Down & Right', 
            'Up & Down & Left & Right'
        ];
        inputHtml += `<select class="prop-input" data-key="${key}">`;
        options.forEach(opt => {
            const isSelected = String(value).trim().toUpperCase() === opt.toUpperCase();
            inputHtml += `<option value="${opt}" ${isSelected ? 'selected' : ''}>${opt}</option>`;
        });
        inputHtml += '</select>';
    }
*/

    else if (key === 'doorType') {
        const options = ['Single', 'Double'];
        inputHtml += `<select class="prop-input" data-key="${key}">`;
        options.forEach(opt => {
            inputHtml += `<option value="${opt}" ${value === opt ? 'selected' : ''}>${opt}</option>`;
        });
        inputHtml += '</select>';
    }
    else if (key === 'textFont') {
        const options = ['Arial', 'Arial Black', 'Arial Narrow', 'Times Roman', 'Calibri', 'Cavolini', 'Courier New' ];
        inputHtml += `<select class="prop-input" data-key="${key}">`;
        options.forEach(opt => {
            inputHtml += `<option value="${opt}" ${value === opt ? 'selected' : ''}>${opt}</option>`;
        });
        inputHtml += '</select>';
    }

    else if (key === 'ledEnabled' || key === 'screenEnabled' || key === 'fanEnabled') {
        // Remove trailing spaces and normalize comparison
        const options = ['true', 'false'];
        inputHtml += `<select class="prop-input" data-key="${key}">`;
        
        options.forEach(opt => {
            // Convert 'value' to string to ensure "true" === "true" comparison works
            const isSelected = String(value).trim().toLowerCase() === opt;
            inputHtml += `<option value="${opt}" ${isSelected ? 'selected' : ''}>${opt}</option>`;
        });
        inputHtml += '</select>';
    }
  
    // CASE: fanOnValue - text input for the Zabbix value that means ON
    else if (key === 'fanOnValue') {
        inputHtml += `<input type="text" class="prop-input" data-key="${key}" value="${value || ''}" 
            placeholder="e.g., 1, ON, 48" title="Zabbix value that indicates Fan is ON">`;
    }

    // EDUCT RELATED
    else if (key === 'enableEndFeedRight' || key === 'enableEndFeedLeft' || key === 'enableHangingScrews' || key === 'flowAnimation') {
        const options = ['Enable', 'Close'];
        inputHtml += `<select class="prop-input" data-key="${key}">`;
        options.forEach(opt => {
            inputHtml += `<option value="${opt}" ${value === opt ? 'selected' : ''}>${opt}</option>`;
        });
        inputHtml += '</select>';
    }
    else if (key === 'arrowFlowDirection') {
        const options = ['LeftToRight', 'RightToLeft'];
        inputHtml += `<select class="prop-input" data-key="${key}">`;
        options.forEach(opt => {
            inputHtml += `<option value="${opt}" ${value === opt ? 'selected' : ''}>${opt}</option>`;
        });
        inputHtml += '</select>';
    }
    // CASE: Vector Objects (Position, Size, etc.)
    else if (isVector && typeof value === 'object' && value !== null) {

        // --- PINPOINT CORRECTION START ---
        let fields = [];
        if (key.toLowerCase().includes('position') || key === 'ledOffset') {
            fields = ['x', 'y', 'z']; // Always show 3 axes for positions
        } else if (key === 'textbgSize' || key === 'screenSize' || key === 'highTextbgSize') {
            fields = ['width', 'height']; // No 'depth' for these specific 2D sizes
        } else if (key.toLowerCase().includes('size')) {
            fields = ['width', 'height', 'depth']; // Standard 3D sizes
        } else {
            fields = Object.keys(value); // Fallback to existing keys
        }
        // --- PINPOINT CORRECTION END ---

        inputHtml += '<div class="vector-inputs" style="display:flex; gap:4px; align-items:center;">';
        fields.forEach(comp => {
            const val = (value && value[comp] !== undefined) ? value[comp] : 0;
            inputHtml += `
                <span style="font-size:11px; color:#666;">${comp}</span>
                <input class="prop-input" data-key="${key}.${comp}" type="number" step="0.01"
                       value="${parseFloat(val).toFixed(2)}" style="width:50px; padding:2px;">`;
        });
        inputHtml += '</div>';
    }
    // CASE: Colors
    else if (typeof value === 'number' && key.toLowerCase().includes('color')) {
        const hexValue = value >= 0 ? `0x${Math.floor(value).toString(16).padStart(6, '0').toUpperCase()}` : '0xFFFFFF';
        inputHtml += `<input class="prop-input" data-key="${key}" value="${hexValue}">`;
    }
    // CASE: Decimals/Numbers
    else if (isDecimal || typeof value === 'number') {
        inputHtml += `<input class="prop-input" data-key="${key}" type="number" step="0.01" value="${parseFloat(value || 0).toFixed(2)}">`;
    }
    // CASE: General Strings
    else {
        inputHtml += `<input class="prop-input" data-key="${key}" value="${value || ''}">`;
    }


    return `<div class="prop-row" style="display:flex; align-items:center; margin-bottom:8px;">
                <label style="min-width:120px; font-size:13px;">${key}:</label>
                ${inputHtml}
            </div>`;
}


// New: Toggle group
toggleGroup(header) {
  const content = header.nextElementSibling;
  content.classList.toggle('show');
  header.querySelector('span:last-child').textContent = content.classList.contains('show') ? '▲' : '▼';
}

async handleTextureUpload(e, side) {
    const file = e.target.files[0];
    if (!file || !this.selectedDevice) return;

    // naming: ups1_front.png
    const fileName = `${this.selectedDevice}_${side}.png`;

    const formData = new FormData();
    formData.append('texture', file);
    formData.append('filename', fileName);
    formData.append('room', this.selectedFile);
    formData.append('device', this.selectedDevice);
    formData.append('side', side);

    try {
        const response = await fetch('/api/uploadtexture', {
            method: 'POST',
            body: formData
        });
        const data = await response.json();

        if (data.success) {
            //alert(`Uploaded ${side} texture successfully!`);
            // Refresh properties to show new path and reload 3D preview
            await this.loadDeviceProperties(this.selectedFile, this.selectedDevice);
            this.updatePreview();
        } else {
            alert('Upload failed: ' + data.error);
        }
    } catch (error) {
        //console.error('Upload error', error);
        alert('Network error during upload');
    }
}

