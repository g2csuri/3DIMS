applyChanges() {
    if (!this.selectedFile || !this.selectedDevice) {
        alert("Select a device first.");
        return;
    }

    const changes = {};
    const inputs = this.propertiesEditor.querySelectorAll('.prop-input');

    inputs.forEach(input => {
        const key = input.dataset.key;
        if (!key) return;

        let val = input.value.trim();

        // Check if property should be a number (float)
        const isDecimal = DECIMAL_PROPS.some(p => key.startsWith(p)) || key.startsWith("plugInBoxPositions.");

        if (val === "" || val.toLowerCase() === "null") {
            val = null;
        } else if (val.toLowerCase() === "true") {
            val = true;
        } else if (val.toLowerCase() === "false") {
            val = false;
        } else if (val.startsWith("0x")) {
            // Keep hex as string for the Python formatter to handle
        } else if (!isNaN(val) && isDecimal) {
            val = parseFloat(val);
        } else if (!isNaN(val)) {
            val = Number(val);
        }

        // Handle nested array indexing (e.g., key = "plugInBoxPositions.0")
        if (key.includes('.')) {
            const [parentKey, indexStr] = key.split('.');
            const idx = parseInt(indexStr, 10);

            if (!isNaN(idx)) {
                if (!Array.isArray(changes[parentKey])) {
                    changes[parentKey] = [];
                }
                changes[parentKey][idx] = val;
                return;
            }
        }

        changes[key] = val;
    });

    this.saveDeviceChanges(changes);
}

// New: Save to backend
async saveDeviceChanges(changes) {
  try {
    const response = await fetch('/api/updatedeviceprops', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ room: this.selectedFile, device: this.selectedDevice, changes })
    });
    const data = await response.json();
    if (data.success) {
      //alert('Properties updated! Preview reloaded.');
      this.loadDeviceProperties(this.selectedFile, this.selectedDevice); // Reload form
      this.updatePreview();
    } else {
      alert('Update failed: ' + data.error);
    }
  } catch (error) {
    //console.error('Save error', error);
  }

/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

// Export Function
function exportProject() {
    window.location.href = '/export_project';
}

// Restore Helper: Triggers the hidden file input
function triggerRestore() {
    document.getElementById('restore-input').click();
}

// Restore Handler: Sends the file to Python
function handleRestore(input) {
    if (!input.files || input.files.length === 0) return;

    if (!confirm("Warning: This will overwrite all current i3DLive files. Continue?")) return;

    const formData = new FormData();
    formData.append('file', input.files[0]);

    fetch('/restore_project', {
        method: 'POST',
        body: formData
    })
    .then(response => response.json())
    .then(data => {
        alert(data.message);
        if (data.status === 'success') {
            window.location.reload();
        }
    })
    .catch(error => {
        //console.error('Error:', error);
        alert("Restore failed. Check console for details.");
    });
}


/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

}

// Helper to handle file picking
pickTexture(side) {
    const input = document.createElement('input');
    input.type = 'file';
    input.accept = 'image/\*';
    input.onchange = (e) => this.handleTextureUpload(e, side);
    input.click();
}


} // end of class EditorTree function

// INITIALIZATION: Replace the block at the very bottom
document.addEventListener('DOMContentLoaded', () => {
    // Check if instance already exists to prevent double-init
    if (!window.editorInstance) {
        const editor = new EditorTree();
        //window.editorInstance = editor;
        window.editor = editor;

        // Ensure Room functions are also globally accessible
        window.promptAddRoom = () => editorInstance.promptAddRoom();
        window.confirmRemoveRoom = () => editorInstance.confirmRemoveRoom();

    }
});


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

// --- EXPORT & RESTORE UTILITIES ---

// 1. Export Function
function exportProject() {
    //console.log("Exporting project...");
    window.location.href = '/export_project';
}

// 2. Trigger the hidden file input
function triggerRestore() {
    const input = document.getElementById('restore-input');
    if (input) {
        input.click();
    } else {
        //console.error("Restore input element not found!");
    }
}

// 3. Handle the actual file upload
function handleRestore(input) {
    if (!input.files || input.files.length === 0) return;

    if (!confirm("CRITICAL WARNING: This will DELETE the current i3DLive folder on the server and replace it with the ZIP content. Continue?")) {
        input.value = ''; // Reset input
        return;
    }

    const formData = new FormData();
    formData.append('file', input.files[0]);

    // Show a simple status (optional)
    const restoreBtn = document.getElementById('restore-btn');
    const originalText = restoreBtn.innerText;
    restoreBtn.innerText = "Restoring...";
    restoreBtn.disabled = true;

    fetch('/restore_project', {
        method: 'POST',
        body: formData
    })
    .then(response => response.json())
    .then(data => {
        alert(data.message);
        if (data.status === 'success') {
            window.location.reload();
        }
    })
    .catch(error => {
        //console.error('Error:', error);
        alert("Restore failed. Check server logs.");
    })
    .finally(() => {
        restoreBtn.innerText = originalText;
        restoreBtn.disabled = false;
        input.value = ''; // Reset input
    });
}
