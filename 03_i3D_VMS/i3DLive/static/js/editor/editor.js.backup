// Function to Add Room
async promptAddRoom() {

    var roomName = prompt("Enter the room name (e.g., 'Security'):");
    
    if (roomName && roomName.trim() !== "") {
        // Clean the name: remove spaces and special characters
        var cleanName = roomName.replace(/[^a-z0-9]/gi, '').toLowerCase();

        fetch('/add_room', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name: cleanName })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                alert("Room '" + cleanName + "room.js' created successfully!");
                location.reload(); // Refresh to include the new JS file in the DOM
            } else {
                alert("Error: " + data.error);
            }
        })
        .catch(err => {
            //console.error("Fetch Error:", err);
            alert("Failed to connect to server.");
        });
    }

}


async confirmRemoveRoom() {
    if (!this.selectedRoom) {
        alert("Please select a room from the 'Room' dropdown menu first.");
        return;
    }

    const selectedFile = this.selectedRoom;
    const confirmed = confirm(`Are you sure you want to delete ${selectedFile}?`);
    
    if (confirmed) {
        try {
            // e.g., "serverroom.js" -> "serverroom"
            const functionName = selectedFile.replace('.js', '');

            const response = await fetch('/remove_room', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ filename: selectedFile })
            });
            const data = await response.json();

            if (data.success) {
                // FIX: Set to null instead of 'delete' to avoid non-configurable errors
                if (window[functionName]) {
                    window[functionName] = null; 
                    //console.log(`🗑️ Cleared ${functionName} from global memory`);
                }

                alert("Room deleted successfully.");
                this.selectedRoom = null;
                document.querySelector('#room-library-btn .selected-text').textContent = 'Select Room...';
                
                await this.loadTree();
                await this.updatePreview();
            } else {
                alert("Error: " + data.error);
            }
        } catch (err) {
            console.error("Fetch Error:", err);
        }
    }
}

