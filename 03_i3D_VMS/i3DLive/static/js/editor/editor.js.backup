    async loadDeviceLibrary() {
        try {
            const response = await fetch('/api/device_library');
            const devices = await response.json();

            const dropdown = document.getElementById('device-library-dropdown');
            const button = document.getElementById('device-library-btn');
            dropdown.innerHTML = '';  // Clear

            devices.forEach(device => {
                const option = document.createElement('div');
                option.className = 'dropdown-option';
                option.dataset.filename = device.filename;
                option.textContent = device.display;
                option.onclick = () => this.selectLibraryDevice(device);
                dropdown.appendChild(option);
            });

            // Click handlers
            button.onclick = () => {
                const isOpen = dropdown.classList.contains('show');
                document.querySelectorAll('.select-dropdown').forEach(d => d.classList.remove('show'));
                if (!isOpen) dropdown.classList.add('show');
            };

            // Close on outside click
            document.addEventListener('click', (e) => {
                if (!button.contains(e.target) && !dropdown.contains(e.target)) {
                    dropdown.classList.remove('show');
                }
            });

                //console.log(`Loaded ${devices.length} devices - scrollable`);
            } catch (error) {
                //console.error('Failed to load device library:', error);
          }
      }

        // NEW: Handle device selection
      selectLibraryDevice(device) {
          const button = document.getElementById('device-library-btn');
          const dropdown = document.getElementById('device-library-dropdown');
          button.querySelector('.selected-text').textContent = device.display;
          dropdown.classList.remove('show');
          //console.log(`Selected library device: ${device.filename}`);

          this.selectedDeviceFile = device.filename;
          //console.log(`Selected device: ${device.filename}`);
          // Add logic here later for Add button
      }

