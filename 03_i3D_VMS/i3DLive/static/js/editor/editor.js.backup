////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

addEditorLights(targetScene) {
    if (!targetScene) return;

    // Set background color correctly
    targetScene.background = new THREE.Color(0x000000); // Dark grey instead of black

    // 1. Ambient Light
    const ambientLight = new THREE.AmbientLight(0xFFFFFF, 0.6);
    ambientLight.name = "editor_ambient";
    targetScene.add(ambientLight);

    // 2. Directional Light
    const directionalLight = new THREE.DirectionalLight(0xFFFFFF, 0.7);
    directionalLight.position.set(5, 10, 7);
    directionalLight.castShadow = true;
    directionalLight.name = "editor_directional";
    targetScene.add(directionalLight);

    //console.log("💡 Lights and Background restored to target scene");
}

async updatePreview() {
    //console.log('🔄 Dynamic Global Refresh...');
    const targetScene = window.editorScene;
    if (!targetScene) return;

    // 1. Clear the entire preview scene
    while (targetScene.children.length > 0) {
        targetScene.remove(targetScene.children[0]);
    }

    this.addEditorLights(targetScene);
    window.scene = targetScene;
    window.camera = window.editorCamera;

    try {
        const treeResp = await fetch('/api/tree');
        const rooms = await treeResp.json();
        
        // Get names like ['serverroom', 'securityroom']
        const validRoomFunctions = rooms.map(r => r.name.replace('.js', ''));

        // 2. SAFE CLEANUP: Set obsolete room functions to null
        Object.keys(window).forEach(key => {
            // Only target keys that end with 'room' and are not in our current valid list
            if (key.endsWith('room') && !validRoomFunctions.includes(key) && typeof window[key] === 'function') {
                try {
                    window[key] = null; // Safer than 'delete' for non-configurable properties
                    //console.log(`🧹 Nullified obsolete function: ${key}`);
                } catch (e) {
                    //console.warn(`Could not nullify ${key}:`, e);
                }
            }
        });

        for (const room of rooms) {
            const fileName = room.name;
            const cacheBuster = Date.now();
            const response = await fetch(`/api/load_layout/${fileName}.js?t=${cacheBuster}`);
            const data = await response.json();

            if (data.success) {
                const functionMatch = data.content.match(/function\s+([a-zA-Z0-9_]+)\s*\(/);
                const detectedFuncName = functionMatch ? functionMatch[1] : null;

                if (detectedFuncName) {
                    const scriptRunner = new Function('THREE', 'scene', 'camera', `
                        ${data.content}
                        if (typeof ${detectedFuncName} === 'function') {
                            window.${detectedFuncName} = ${detectedFuncName};
                        }
                    `);
                    scriptRunner(THREE, targetScene, window.editorCamera);
                }
            }
        }

        // 3. Re-run layout
        if (typeof mainlayout === 'function') {
            mainlayout();
            console.log("✅ Render updated.");
        }

    } catch (err) {
        console.error("❌ Dynamic global refresh failed:", err);
    }

    if (window.editorRenderer) {
        window.editorRenderer.render(targetScene, window.editorCamera);
    }
}

