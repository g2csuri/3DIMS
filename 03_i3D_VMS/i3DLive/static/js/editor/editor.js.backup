// Add at top of EditorTree class or globally
const DECIMAL_PROPS = [
    'deviceWidth', 'deviceHeight', 'deviceDepth',
    'textSize', 'ledRadius', 'ledHeight', 'ledBlinkPeriod',
    'highTextSize', 'highLineWidth', 'highDotRadius',
    'screenSize', 'textbgSize', 'highTextbgSize',
    'doorWidth', 'doorHeight', 'doorOffset',
    'fanSpeed', 'fanSize', 'plugWidth'
];

class EditorTree {

    constructor() {
        this.treeContainer = document.getElementById('tree-container');
        this.propertiesEditor = document.getElementById('props-editor');
        this.deviceVars = {};
        this.threeContainer = document.getElementById('three-canvas-container');
        this.selectedFile = null;
        this.selectedDevice = null;
        this.selectedRoom = null;
        this.selectedDeviceFile = null;
        this.scene = null;  // For updatePreview

        const applyBtn = document.getElementById('apply-changes-btn');
            if (applyBtn) {
                applyBtn.onclick = () => this.applyChanges();
            }

	if (!this.treeContainer || !this.propertiesEditor || !this.threeContainer) {
  	    //console.error('Required DOM elements not found');
  	    return;
	}

        // FIXED 10.1a: Add button INSIDE constructor
        document.getElementById('add-device-btn').onclick = () => this.handleAdd();
        document.getElementById('remove-device-btn').onclick = this.handleRemove.bind(this);


        // Setup Room UI Buttons (The functions you added)
        const addRoomBtn = document.getElementById('add-room-btn');
        if(addRoomBtn) addRoomBtn.onclick = () => this.promptAddRoom();

        const removeRoomBtn = document.getElementById('remove-room-btn');
        if(removeRoomBtn) removeRoomBtn.onclick = () => this.confirmRemoveRoom();

        window.promptAddRoom = () => this.promptAddRoom();
        window.confirmRemoveRoom = () => this.confirmRemoveRoom();

        window.editorScene = null;
        window.editorCamera = null;
        window.editorRenderer = null;
        window.editorControls = null;

        this.loadTree();
        this.loadRoomLibrary();
        this.loadDeviceLibrary();
        this.initEditorThreeJS();
    }


    // ... keep all your existing methods (loadTree, renderTree, toggleNode, selectDevice, initEditorThreeJS, editorAnimate, 
    // ... loadDeviceLibrary, selectLibraryDevice, loadRoomLibrary, selectLibraryRoom) ...

    async loadTree() {
        try {
            const response = await fetch('/api/tree');
            const treeData = await response.json();

            if (treeData.error) {
                this.treeContainer.innerHTML = `<div style="color:red;padding:20px;">Error: ${treeData.error}</div>`;
                return;
            }

            this.renderTree(treeData);
        } catch (error) {
            //console.error('Failed to load tree:', error);
            this.treeContainer.innerHTML = '<div style="color:red;padding:20px;">Failed to load file tree</div>';
        }
    }

    renderTree(files) {
        this.treeContainer.innerHTML = '';

        files.forEach(file => {
            const fileDiv = document.createElement('div');
            fileDiv.className = 'tree-file';
            fileDiv.innerHTML = `
                <div class="tree-node">
                    <span class="toggle collapsed">▶</span>
                    <span class="filename">${file.name}</span>
                </div>
                <div class="tree-children" style="display: none;">
                    ${file.devices.map(device =>
                        `<div class="tree-item device" data-file="${file.name}" data-device="${device.name}">
                            ${device.name}
                        </div>`
                    ).join('')}
                </div>
            `;

            fileDiv.querySelector('.tree-node').onclick = (e) => {
                e.stopPropagation();
                this.toggleNode(fileDiv);
            };

            fileDiv.querySelectorAll('.device').forEach(item => {
                item.onclick = (e) => {
                    e.stopPropagation();
                    this.selectDevice(item.dataset.file, item.dataset.device, e.currentTarget);
                };
            });

            this.treeContainer.appendChild(fileDiv);
        });
    }

    toggleNode(node) {
        const children = node.querySelector('.tree-children');
        const toggle = node.querySelector('.toggle');
        const isCollapsed = toggle.classList.contains('collapsed');

        if (isCollapsed) {
            children.style.display = 'block';
            toggle.textContent = '▼';
            toggle.classList.remove('collapsed');
        } else {
            children.style.display = 'none';
            toggle.textContent = '▶';
            toggle.classList.add('collapsed');
        }
    }

    selectDevice(filename, device, element) {
        document.querySelectorAll('.tree-item').forEach(el => el.classList.remove('selected'));
        element.classList.add('selected');

        this.selectedFile = filename;
        this.selectedDevice = device;

        // Preview updates automatically via scoped animate()
        //console.log(`Selected ${device} from ${filename}`);
        this.loadDeviceProperties(filename, device);
        //this.updatePreview(device);
    }

    // New method: Scoped Three.js init for middle pane only
    initEditorThreeJS() {
        // Prefix globals to avoid conflict with i3DLive.py's window globals
        window.initEditor = () => {
            const container = this.threeContainer;

            // Clear any placeholder
            const placeholder = container.querySelector('div');
            if (placeholder) placeholder.remove();

            // Create scoped scene/renderer/camera for editor
            window.editorScene = new THREE.Scene();
            window.editorScene.background = new THREE.Color(0x000000);

            window.editorCamera = new THREE.PerspectiveCamera(40, container.clientWidth / container.clientHeight, 0.1, 200);
            window.editorCamera.position.set(8, 8, 8);

            window.editorRenderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: "high-performance" });
            window.editorRenderer.setSize(container.clientWidth, container.clientHeight);
            window.editorRenderer.shadowMap.enabled = true;
            window.editorRenderer.shadowMap.type = THREE.PCFSoftShadowMap;
            container.appendChild(window.editorRenderer.domElement);

            // Scoped OrbitControls attached to container only
            window.editorControls = new THREE.OrbitControls(window.editorCamera, window.editorRenderer.domElement);
            window.editorControls.enableDamping = true;
            window.editorControls.dampingFactor = 1.05;
            window.editorControls.target.set(0, 1.0, 0);
            window.editorControls.update();

            // Lights
            const ambientLight = new THREE.AmbientLight(0xFFFFFF, 0.6);
            window.editorScene.add(ambientLight);

            const directionalLight = new THREE.DirectionalLight(0xaaaaaa, 0.7);
            directionalLight.position.set(5, 10, 7);
            directionalLight.castShadow = true;
            window.editorScene.add(directionalLight);

            // Critical: Call your existing init() but scoped to editor globals
            // Override temporarily for this call
            const originalInit = window.init;
            window.init = () => {
                // Use editor globals instead of global ones
                scene = window.editorScene;
                camera = window.editorCamera;
                renderer = window.editorRenderer;
                controls = window.editorControls;

                // Call your mainlayout() which loads rooms/devices
                mainlayout();  // This populates the scoped scene

                // Restore originals after
                scene = window.editorScene;
                camera = window.editorCamera;
                renderer = window.editorRenderer;
                controls = window.editorControls;

                // Start scoped animate
                this.editorAnimate();
            };

            window.init();  // Execute the scoped init()

            // Resize handler for container only
            const resizeEditor = () => {
                const rect = container.getBoundingClientRect();
                window.editorCamera.aspect = rect.width / rect.height;
                window.editorCamera.updateProjectionMatrix();
                window.editorRenderer.setSize(rect.width, rect.height);
            };
            window.addEventListener('resize', resizeEditor);
            resizeEditor();  // Initial resize
        };

        // Start the editor instance
        window.initEditor();
        this.scene = window.editorScene;
        window.editorInstance = this;  // Global access

        //console.log('Editor Three.js initialized in middle pane');
    }

    // Scoped animate loop for editor renderer only
    editorAnimate() {
        requestAnimationFrame(() => this.editorAnimate());
        if (window.editorControls) window.editorControls.update();
        if (window.editorRenderer && window.editorScene && window.editorCamera) {
            window.editorRenderer.render(window.editorScene, window.editorCamera);
        }
    }

