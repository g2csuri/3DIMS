// static/js/device_library/ductLineV1.js

function createDuct(scene, options = {}) {
    const {
        // Main Spatial Layout Dimensions
        ductWidth = 0.3,   // Horizontal width of the rectangular duct profile
        ductHeight = 0.2,  // Vertical height of the rectangular duct profile
        deviceDepth = 2.0, // Total length of the main core duct body
        devicePosition = { x: 0, y: 2.4, z: 0 },

        // Colors & Structural Material Aesthetics
        deviceColor = 0x8899a6, // Industrial silver-gray default for galvanized ductwork

        // Options: 'Horizontal_FrontBack', 'Horizontal_LeftRight', 'Vertical'
        ductOrientation = 'Horizontal_FrontBack',

        // =================================================================
        // ===== FRONT END SHORTENED ROUTING REGISTRY =====
        // =================================================================
        // DUCT BEND 1
        F_D1_Sts = 'Close', // 'Enable' or 'Close'
        F_D1_H   = 0,       // Horizontal Angle (Yaw)
        F_D1_V   = 90,      // Vertical Angle (Pitch)
        F_D1_L   = 0.5,     // Length of run

        // DUCT BEND 2
        F_D2_Sts = 'Close', 
        F_D2_H   = 90,
        F_D2_V   = 0,
        F_D2_L   = 0.5,

        // DUCT BEND 3
        F_D3_Sts = 'Close', 
        F_D3_H   = 90,
        F_D3_V   = -45,
        F_D3_L   = 0.5,

        // =================================================================
        // ===== REAR END SHORTENED ROUTING REGISTRY =====
        // =================================================================
        // DUCT BEND 1
        R_D1_Sts = 'Close', 
        R_D1_H   = 180,
        R_D1_V   = 0,
        R_D1_L   = 0.5,

        // DUCT BEND 2
        R_D2_Sts = 'Close', 
        R_D2_H   = 180,
        R_D2_V   = -90,
        R_D2_L   = 0.5,

        // DUCT BEND 3
        R_D3_Sts = 'Close', 
        R_D3_H   = 270,
        R_D3_V   = 0,
        R_D3_L   = 0.5,

        // FLOW SYSTEM TELEMETRY CONTROLS
        flowAnimation = 'Enable',       
        arrowFlowDirection = 'LeftToRight', 
        flowSpeed = 1.5,                
        flowColor = 0x00aaff, // Cool cyan/blue default for AHU cooling streams           
        arrowIntensity = 1.0,  
        flowOnValue = '1', 
        zbxKey = '',       

        // ===== LIVE MONITORING SYSTEM METADATA =====
        deviceId = '',
        category = 'ducting',
        urlLink = '',
        zbxSrvIP = '',
        zbxAPI = '',
        zbxHost = '',
        zbxHostKeys = [],
        zbxHostKeyValues = []
    } = options;

    const ductGroup = new THREE.Group();
    scene.add(ductGroup);

    const normalizedOrientation = ductOrientation.toUpperCase(); 
    ductGroup.isFlowing = false; 

    // --- 1. GALVANIZED STEEL DUCT MATERIAL ---
    const ductMat = new THREE.MeshPhongMaterial({
        color: deviceColor,
        shininess: 40,
        flatShading: true, // Flat shading gives an authentic sheet-metal paneled look
        emissive: deviceColor,
        emissiveIntensity: 0.02
    });

    // --- 2. HIGH-INTENSITY FRESH AIR STREAM SHADER MATERIAL ---
    let airShaderMat = null;
    let globalTimeUniform = { value: 0.0 };

    if (flowAnimation.toUpperCase() === 'ENABLE') {
        let dirSign = (arrowFlowDirection.toUpperCase() === 'RIGHTTOLEFT' || arrowFlowDirection.toUpperCase() === 'BOTTOMTOTOP') ? -1.0 : 1.0;

        airShaderMat = new THREE.ShaderMaterial({
            uniforms: {
                time: globalTimeUniform,
                baseColor: { value: new THREE.Color(deviceColor) },
                streamColor: { value: new THREE.Color(flowColor) }, 
                speed: { value: flowSpeed * dirSign },              
                intensity: { value: arrowIntensity } 
            },
            vertexShader: `
                varying vec2 vUv;
                varying vec3 vNormal;
                void main() {
                    vUv = uv;
                    vNormal = normalize(normalMatrix * normal);
                    gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
                }
            `,
            fragmentShader: `
                uniform float time;
                uniform vec3 baseColor;
                uniform vec3 streamColor;
                uniform float speed;
                uniform float intensity;
                varying vec2 vUv;
                varying vec3 vNormal;

                void main() {
                    // Rectangular linear stream pattern logic mapping
                    float wave = sin(vUv.y * 25.0 - time * speed * 6.0) * 0.5 + 0.5;
                    float pulse = cos(vUv.x * 2.0 + time * speed) * 0.1 + 0.9;
                    
                    float mixFactor = clamp(wave * pulse * 0.7 * intensity, 0.0, 0.85); 
                    vec3 finalColor = mix(baseColor, streamColor, mixFactor);
                    
                    gl_FragColor = vec4(finalColor, 1.0);
                }
            `
        });
    }

    // --- 3. MAIN CORE DUCT GENERATION (HULL BOX) ---
    // Cylinder layout translated into length matching Box dimensions
    let mainWidth = ductWidth;
    let mainHeight = ductHeight;
    let mainLength = deviceDepth;

    const staticBaseGeo = new THREE.BoxGeometry(mainWidth, mainLength, mainHeight);
    const staticBaseDuct = new THREE.Mesh(staticBaseGeo, ductMat);
    
    const mainGeo = new THREE.BoxGeometry(mainWidth * 1.002, mainLength, mainHeight * 1.002);
    const mainAirDuct = new THREE.Mesh(mainGeo, airShaderMat ? airShaderMat : ductMat);
    
    mainAirDuct.visible = false;

    // Apply baseline operational spatial axis orientation rotations
    if (normalizedOrientation === 'HORIZONTAL_FRONTBACK') {
        staticBaseDuct.rotation.x = Math.PI / 2;
        mainAirDuct.rotation.x = Math.PI / 2;
    } else if (normalizedOrientation === 'HORIZONTAL_LEFTRIGHT') {
        staticBaseDuct.rotation.z = Math.PI / 2;
        mainAirDuct.rotation.z = Math.PI / 2;
    } else if (normalizedOrientation === 'VERTICAL') {
        staticBaseDuct.rotation.set(0, 0, 0); 
        mainAirDuct.rotation.set(0, 0, 0);
    }
    ductGroup.add(staticBaseDuct);
    ductGroup.add(mainAirDuct);


    // --- 4. 3-STAGE RECTANGULAR ANGULAR DUCT ROUTING ENGINE ---
    const buildAngularBranch = (parentX, parentY, parentZ, horizDeg, vertDeg, branchLength) => {
        const theta = (horizDeg * Math.PI) / 180; // Yaw
        const phi = (vertDeg * Math.PI) / 180;    // Pitch

        const dirX = Math.cos(phi) * Math.sin(theta);
        const dirY = Math.sin(phi);
        const dirZ = Math.cos(phi) * Math.cos(theta);

        // A square junction cube box functions as the transitional joint connector elbow for ducts
        // Replaces the pipe sphere connector cleanly
        const jointBoxSize = Math.max(ductWidth, ductHeight) * 1.02;
        const jointBoxGeo = new THREE.BoxGeometry(jointBoxSize, jointBoxSize, jointBoxSize);
        const jointBox = new THREE.Mesh(jointBoxGeo, ductMat);
        jointBox.position.set(parentX, parentY, parentZ);
        ductGroup.add(jointBox);

        // Build the secondary rectangular extension branch duct segment
        const branchGeo = new THREE.BoxGeometry(ductWidth, branchLength, ductHeight);
        const branchMesh = new THREE.Mesh(branchGeo, ductMat);

        const targetTipX = parentX + dirX * branchLength;
        const targetTipY = parentY + dirY * branchLength;
        const targetTipZ = parentZ + dirZ * branchLength;

        branchMesh.position.set(
            (parentX + targetTipX) / 2,
            (parentY + targetTipY) / 2,
            (parentZ + targetTipZ) / 2
        );

        // Orient the box mesh smoothly along the continuous 3D coordinate vector line path
        const upVector = new THREE.Vector3(0, 1, 0);
        const directionVector = new THREE.Vector3(dirX, dirY, dirZ).normalize();
        branchMesh.quaternion.setFromUnitVectors(upVector, directionVector);
        
        ductGroup.add(branchMesh);

        return { x: targetTipX, y: targetTipY, z: targetTipZ };
    };

    const processTerminalDuctline = (isFrontEnd, d1Sts, d1H, d1V, d1L, d2Sts, d2H, d2V, d2L, d3Sts, d3H, d3V, d3L) => {
        const halfLengthPos = deviceDepth / 2;
        const directionSign = isFrontEnd ? 1 : -1;
        let startX = 0, startY = 0, startZ = 0;

        if (normalizedOrientation === 'HORIZONTAL_FRONTBACK')  startZ = halfLengthPos * directionSign;
        else if (normalizedOrientation === 'HORIZONTAL_LEFTRIGHT') startX = halfLengthPos * directionSign;
        else if (normalizedOrientation === 'VERTICAL')             startY = halfLengthPos * directionSign;

        // Base box termination flat cap checking matrix
        if (d1Sts.toUpperCase() !== 'ENABLE') {
            const capGeo = new THREE.BoxGeometry(ductWidth, 0.005, ductHeight);
            const cap = new THREE.Mesh(capGeo, ductMat);
            cap.position.set(startX, startY, startZ);

            if (normalizedOrientation === 'HORIZONTAL_FRONTBACK')  cap.rotation.x = Math.PI / 2;
            else if (normalizedOrientation === 'HORIZONTAL_LEFTRIGHT') cap.rotation.z = Math.PI / 2;
            else if (normalizedOrientation === 'VERTICAL')             cap.rotation.set(0, 0, 0);

            ductGroup.add(cap);
            return;
        }

        // Run continuous cascade execution pipeline paths over the duct array framework
        const stage1Tip = buildAngularBranch(startX, startY, startZ, d1H, d1V, d1L);

        if (d2Sts.toUpperCase() === 'ENABLE') {
            const stage2Tip = buildAngularBranch(stage1Tip.x, stage1Tip.y, stage1Tip.z, d2H, d2V, d2L);

            if (d3Sts.toUpperCase() === 'ENABLE') {
                buildAngularBranch(stage2Tip.x, stage2Tip.y, stage2Tip.z, d3H, d3V, d3L);
            }
        }
    };

    // Compile Front and Rear HVAC Distribution branch lines
    processTerminalDuctline(true, F_D1_Sts, F_D1_H, F_D1_V, F_D1_L, F_D2_Sts, F_D2_H, F_D2_V, F_D2_L, F_D3_Sts, F_D3_H, F_D3_V, F_D3_L);
    processTerminalDuctline(false, R_D1_Sts, R_D1_H, R_D1_V, R_D1_L, R_D2_Sts, R_D2_H, R_D2_V, R_D2_L, R_D3_Sts, R_D3_H, R_D3_V, R_D3_L);

    ductGroup.position.set(devicePosition.x, devicePosition.y, devicePosition.z);


    // =================================================================
    // TELEMETRY ENGINE & KEY INTERCEPT VALIDATION
    // =================================================================
    ductGroup.applyLiveData = function(row) {
        if (!row) {
            this.isFlowing = false;
            mainAirDuct.visible = false;
            return;
        }

        let statusValue = undefined;
        const checkKey = zbxKey ? zbxKey.trim() : '';

        if (checkKey !== '') {
            if (row.key === checkKey || row.itemkey === checkKey || row.zbxKey === checkKey) {
                statusValue = (row.value !== undefined) ? row.value : row.status;
            } else if (row[checkKey] !== undefined) {
                statusValue = row[checkKey];
            }
        }

        if (statusValue === undefined) {
            if (row.status !== undefined && row.status !== null) statusValue = row.status;
            else if (row.value !== undefined && row.value !== null) statusValue = row.value;
            else if (row.val !== undefined && row.val !== null) statusValue = row.val;
        }

        if (statusValue === undefined || statusValue === null) {
            this.isFlowing = false;
            mainAirDuct.visible = false;
            return;
        }

        let parsedVal = String(statusValue).trim().toLowerCase();
        let targetOnVal = String(flowOnValue).trim().toLowerCase();

        if (parsedVal === targetOnVal || parsedVal === '1' || parsedVal === 'true' || parsedVal === 'on' || parsedVal === 'run') {
            this.isFlowing = true;
        } else {
            this.isFlowing = false;
        }

        mainAirDuct.visible = this.isFlowing;
    };

    // =================================================================
    // RUNTIME ANIMATION TICKER LOOP
    // =================================================================
    ductGroup.updateDuctAnimation = function(dt) {
        if (!dt) dt = 0.016;
        if (!this.isFlowing || !mainAirDuct.visible) return;
        globalTimeUniform.value += dt;
    };

    ductGroup.updateFan = function(dt) {
        this.updateDuctAnimation(dt);
    };

    // Telemetry and Management Metadata properties allocation
    ductGroup.deviceMetadata = {
        deviceId, category, urlLink, zbxSrvIP, zbxAPI, zbxHost, zbxHostKeys, zbxHostKeyValues, zbxKey, flowOnValue,
        ductWidth, ductHeight,
        
        // Front End Trackers mapped to options payload structures
        F_D1_Sts, F_D1_H, F_D1_V, F_D1_L,
        F_D2_Sts, F_D2_H, F_D2_V, F_D2_L,
        F_D3_Sts, F_D3_H, F_D3_V, F_D3_L,

        // Rear End Trackers mapped to options payload structures
        R_D1_Sts, R_D1_H, R_D1_V, R_D1_L,
        R_D2_Sts, R_D2_H, R_D2_V, R_D2_L,
        R_D3_Sts, R_D3_H, R_D3_V, R_D3_L
    };

    ductGroup.getDeviceMetadata = function() { return this.deviceMetadata; };
    ductGroup.updateDeviceMetadata = function(m) { Object.assign(this.deviceMetadata, m); };

    return ductGroup;
}
